diff --git a/src/spice2x/hooks/graphics/graphics_udn.cpp b/src/spice2x/hooks/graphics/graphics_udn.cpp
new file mode 100644
index 0000000..9967ca8
--- /dev/null
+++ b/src/spice2x/hooks/graphics/graphics_udn.cpp
@@ -0,0 +1,225 @@
+#include "graphics_udn.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "avs/game.h"
+#include "cfg/screen_resize.h"
+#include "hooks/graphics/graphics.h"
+#include "util/logging.h"
+#include "util/time.h"
+
+static bool UDN_INTERACTIVE_WINDOW_RESIZE = false;
+
+static bool udn_is_managed_window(HWND hWnd) {
+    return GRAPHICS_WINDOWED && avs::game::is_model("UDN") &&
+        GRAPHICS_HOOKED_WINDOW.has_value() && hWnd == GRAPHICS_HOOKED_WINDOW.value();
+}
+
+static bool udn_should_adjust_game_placement(HWND hWnd) {
+    return udn_is_managed_window(hWnd) && cfg::SCREENRESIZE != nullptr &&
+        cfg::SCREENRESIZE->enable_window_resize;
+}
+
+UINT graphics_udn_enforce_message() {
+    static const UINT message = RegisterWindowMessageW(
+        L"SpiceTools.UDN.EnforceWindow");
+    return message;
+}
+
+static bool udn_get_target_window_rect(HWND hWnd, RECT &target) {
+    if (!udn_is_managed_window(hWnd) || !GRAPHICS_WINDOW_SIZE.has_value()) {
+        return false;
+    }
+
+    const DWORD style =
+        ((DWORD) GetWindowLongPtrW(hWnd, GWL_STYLE) |
+         WS_OVERLAPPEDWINDOW | WS_VISIBLE) & ~WS_POPUP;
+    const DWORD ex_style = (DWORD) GetWindowLongPtrW(hWnd, GWL_EXSTYLE);
+    RECT frame {
+        0,
+        0,
+        (LONG) GRAPHICS_WINDOW_SIZE->first,
+        (LONG) GRAPHICS_WINDOW_SIZE->second,
+    };
+    AdjustWindowRectEx(&frame, style, GetMenu(hWnd) != nullptr, ex_style);
+    const int outer_width = frame.right - frame.left;
+    const int outer_height = frame.bottom - frame.top;
+
+    // graphics_load_windowed_parameters initializes these from -windowpos,
+    // while WM_MOVE keeps them synchronized after an interactive drag.
+    const int x = cfg::SCREENRESIZE->window_offset_x;
+    const int y = cfg::SCREENRESIZE->window_offset_y;
+    target = {x, y, x + outer_width, y + outer_height};
+    return true;
+}
+
+void graphics_udn_force_window(HWND hWnd) {
+    if (UDN_INTERACTIVE_WINDOW_RESIZE) {
+        return;
+    }
+
+    RECT target {};
+    RECT current {};
+    RECT client {};
+    if (!udn_get_target_window_rect(hWnd, target) ||
+        !GetWindowRect(hWnd, &current) || !GetClientRect(hWnd, &client)) {
+        return;
+    }
+
+    const DWORD style_before = (DWORD) GetWindowLongPtrW(hWnd, GWL_STYLE);
+    const DWORD style_after =
+        (style_before | WS_OVERLAPPEDWINDOW | WS_VISIBLE) & ~WS_POPUP;
+    const int target_client_width = (int) GRAPHICS_WINDOW_SIZE->first;
+    const int target_client_height = (int) GRAPHICS_WINDOW_SIZE->second;
+    const bool wrong = IsZoomed(hWnd) || style_before != style_after ||
+        current.left != target.left || current.top != target.top ||
+        current.right != target.right || current.bottom != target.bottom ||
+        client.right - client.left != target_client_width ||
+        client.bottom - client.top != target_client_height;
+    if (!wrong) {
+        return;
+    }
+
+    // This function is invoked from the window's own message-queue hook. It is
+    // therefore safe to restore, restyle, and resize without blocking Unity's
+    // render thread.
+    if (IsZoomed(hWnd)) {
+        ShowWindow(hWnd, SW_RESTORE);
+    }
+    if (style_before != style_after) {
+        SetWindowLongPtrW(hWnd, GWL_STYLE, (LONG_PTR) style_after);
+    }
+    graphics_set_window_pos(
+        hWnd,
+        HWND_NOTOPMOST,
+        target.left,
+        target.top,
+        target.right - target.left,
+        target.bottom - target.top,
+        SWP_NOACTIVATE | SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+    log_info(
+        "graphics",
+        "UDN owner-thread window restored: client {}x{}, outer {}x{} at ({}, {})",
+        target_client_width,
+        target_client_height,
+        target.right - target.left,
+        target.bottom - target.top,
+        target.left,
+        target.top);
+}
+
+static void udn_constrain_window_message(
+        HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
+    if (!udn_is_managed_window(hWnd)) {
+        return;
+    }
+
+    if (uMsg == WM_ENTERSIZEMOVE) {
+        UDN_INTERACTIVE_WINDOW_RESIZE = true;
+        return;
+    }
+    if (uMsg == WM_EXITSIZEMOVE) {
+        UDN_INTERACTIVE_WINDOW_RESIZE = false;
+        RECT client {};
+        if (GetClientRect(hWnd, &client) && GRAPHICS_WINDOW_SIZE.has_value()) {
+            GRAPHICS_WINDOW_SIZE = std::make_pair(
+                (uint32_t) std::max(1L, client.right - client.left),
+                (uint32_t) std::max(1L, client.bottom - client.top));
+        }
+        return;
+    }
+
+    if (uMsg == WM_STYLECHANGING &&
+        wParam == static_cast<WPARAM>(GWL_STYLE) && lParam != 0) {
+        auto styles = reinterpret_cast<STYLESTRUCT *>(lParam);
+        styles->styleNew =
+            (styles->styleNew | WS_OVERLAPPEDWINDOW | WS_VISIBLE) & ~WS_POPUP;
+        return;
+    }
+
+    if (uMsg != WM_WINDOWPOSCHANGING || lParam == 0 ||
+        UDN_INTERACTIVE_WINDOW_RESIZE || !GRAPHICS_WINDOW_SIZE.has_value()) {
+        return;
+    }
+
+    auto position = reinterpret_cast<WINDOWPOS *>(lParam);
+    const bool moves = (position->flags & SWP_NOMOVE) == 0;
+    const bool resizes = (position->flags & SWP_NOSIZE) == 0;
+    if (!moves && !resizes) {
+        return;
+    }
+
+    RECT target {};
+    if (!udn_get_target_window_rect(hWnd, target)) {
+        return;
+    }
+    const int client_width = (int) GRAPHICS_WINDOW_SIZE->first;
+    const int client_height = (int) GRAPHICS_WINDOW_SIZE->second;
+    const int outer_width = target.right - target.left;
+    const int outer_height = target.bottom - target.top;
+    const int target_x = target.left;
+    const int target_y = target.top;
+
+    const bool changed =
+        position->x != target_x || position->y != target_y ||
+        position->cx != outer_width || position->cy != outer_height;
+    position->flags &= ~(SWP_NOMOVE | SWP_NOSIZE);
+    position->x = target_x;
+    position->y = target_y;
+    position->cx = outer_width;
+    position->cy = outer_height;
+
+    static uint64_t last_log = 0;
+    const uint64_t now = get_system_milliseconds();
+    if (changed && now - last_log >= 1000) {
+        last_log = now;
+        log_info(
+            "graphics",
+            "UDN owner-thread window clamp: client {}x{}, outer {}x{} at ({}, {})",
+            client_width,
+            client_height,
+            outer_width,
+            outer_height,
+            target_x,
+            target_y);
+    }
+}
+
+bool graphics_udn_wndproc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
+    if (uMsg == graphics_udn_enforce_message()) {
+        graphics_udn_force_window(hWnd);
+        return true;
+    }
+
+    udn_constrain_window_message(hWnd, uMsg, wParam, lParam);
+    return false;
+}
+
+void graphics_udn_adjust_move_window(
+        HWND hWnd, int &x, int &y, int &width, int &height) {
+    if (!udn_should_adjust_game_placement(hWnd)) {
+        return;
+    }
+
+    x = cfg::SCREENRESIZE->window_offset_x;
+    y = cfg::SCREENRESIZE->window_offset_y;
+    width = cfg::SCREENRESIZE->client_width + cfg::SCREENRESIZE->window_deco_width;
+    height = cfg::SCREENRESIZE->client_height + cfg::SCREENRESIZE->window_deco_height;
+}
+
+void graphics_udn_adjust_set_window_pos(
+        HWND hWnd, int &x, int &y, int &width, int &height, UINT flags) {
+    if (!udn_should_adjust_game_placement(hWnd)) {
+        return;
+    }
+
+    if ((flags & SWP_NOMOVE) == 0) {
+        x = cfg::SCREENRESIZE->window_offset_x;
+        y = cfg::SCREENRESIZE->window_offset_y;
+    }
+    if ((flags & SWP_NOSIZE) == 0) {
+        width = cfg::SCREENRESIZE->client_width + cfg::SCREENRESIZE->window_deco_width;
+        height = cfg::SCREENRESIZE->client_height + cfg::SCREENRESIZE->window_deco_height;
+    }
+}
