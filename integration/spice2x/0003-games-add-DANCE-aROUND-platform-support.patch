diff --git a/src/spice2x/games/udn/udn.cpp b/src/spice2x/games/udn/udn.cpp
new file mode 100644
index 0000000..e6d7803
--- /dev/null
+++ b/src/spice2x/games/udn/udn.cpp
@@ -0,0 +1,327 @@
+// QueryDisplayConfig
+#define _WIN32_WINNT 0x0601
+
+#include "udn.h"
+
+#include <algorithm>
+#include <format>
+
+#include "acioemu/handle.h"
+#include "bi2x_hook.h"
+#include "cfg/screen_resize.h"
+#include "hooks/devicehook.h"
+#include "hooks/graphics/graphics.h"
+#include "rawinput/rawinput.h"
+#include "util/detour.h"
+#include "util/execexe.h"
+#include "util/logging.h"
+#include "util/unity_player.h"
+
+namespace games::udn {
+    std::string UDN_INJECT_ARGS = "";
+    bool UDN_NO_IO = false;
+
+    static acioemu::ACIOHandle *acio_handle = nullptr;
+    static const std::wstring port_name = L"COM1";
+
+    static decltype(RegisterRawInputDevices) *RegisterRawInputDevices_orig = nullptr;
+    static decltype(EnumDisplaySettingsW) *EnumDisplaySettingsW_orig = nullptr;
+    static decltype(QueryDisplayConfig) *QueryDisplayConfig_orig = nullptr;
+    static decltype(CreateWindowExA) *CreateWindowExA_orig = nullptr;
+    static decltype(CreateWindowExW) *CreateWindowExW_orig = nullptr;
+    static decltype(SetWindowPos) *SetWindowPos_orig = nullptr;
+    static decltype(MoveWindow) *MoveWindow_orig = nullptr;
+    static decltype(SetWindowLongA) *SetWindowLongA_orig = nullptr;
+    static decltype(SetWindowLongW) *SetWindowLongW_orig = nullptr;
+    using SetWindowLongPtrA_t = LONG_PTR (WINAPI *)(HWND, int, LONG_PTR);
+    using SetWindowLongPtrW_t = LONG_PTR (WINAPI *)(HWND, int, LONG_PTR);
+    static SetWindowLongPtrA_t SetWindowLongPtrA_orig = nullptr;
+    static SetWindowLongPtrW_t SetWindowLongPtrW_orig = nullptr;
+
+    static bool is_unity_window_class(LPCSTR class_name) {
+        return class_name && reinterpret_cast<uintptr_t>(class_name) > UINT16_MAX &&
+            _stricmp(class_name, "UnityWndClass") == 0;
+    }
+
+    static bool is_unity_window_class(LPCWSTR class_name) {
+        return class_name && reinterpret_cast<uintptr_t>(class_name) > UINT16_MAX &&
+            _wcsicmp(class_name, L"UnityWndClass") == 0;
+    }
+
+    static bool is_udn_unity_window(HWND window) {
+        if (!window) {
+            return false;
+        }
+        wchar_t class_name[64] {};
+        return GetClassNameW(window, class_name, (int) std::size(class_name)) > 0 &&
+            _wcsicmp(class_name, L"UnityWndClass") == 0;
+    }
+
+    static DWORD force_udn_window_style(DWORD style) {
+        return (style | WS_OVERLAPPEDWINDOW | WS_VISIBLE) & ~WS_POPUP;
+    }
+
+    static bool get_udn_window_rect(
+            DWORD style, DWORD ex_style,
+            int &x, int &y, int &outer_width, int &outer_height) {
+
+        if (!GRAPHICS_WINDOWED || !GRAPHICS_WINDOW_SIZE.has_value()) {
+            return false;
+        }
+        RECT rect {
+            0,
+            0,
+            (LONG) GRAPHICS_WINDOW_SIZE->first,
+            (LONG) GRAPHICS_WINDOW_SIZE->second,
+        };
+        AdjustWindowRectEx(&rect, style, false, ex_style);
+        outer_width = (int) (rect.right - rect.left);
+        outer_height = (int) (rect.bottom - rect.top);
+
+        RECT work {0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN)};
+        SystemParametersInfoW(SPI_GETWORKAREA, 0, &work, 0);
+        x = (int) work.left + std::max(
+            0,
+            ((int) (work.right - work.left) - outer_width) / 2);
+        y = (int) work.top + std::max(
+            0,
+            ((int) (work.bottom - work.top) - outer_height) / 2);
+        return true;
+    }
+
+    static HWND WINAPI CreateWindowExW_hook(
+            DWORD ex_style, LPCWSTR class_name, LPCWSTR window_name, DWORD style,
+            int x, int y, int width, int height, HWND parent, HMENU menu,
+            HINSTANCE instance, LPVOID param) {
+
+        const bool is_unity = is_unity_window_class(class_name) &&
+            window_name && _wcsicmp(window_name, L"DANCEaROUND") == 0;
+        if (is_unity && GRAPHICS_WINDOWED) {
+            style = force_udn_window_style(style);
+            get_udn_window_rect(style, ex_style, x, y, width, height);
+        }
+
+        const auto result = CreateWindowExW_orig(
+            ex_style, class_name, window_name, style,
+            x, y, width, height, parent, menu, instance, param);
+        if (result && is_unity && !GRAPHICS_HOOKED_WINDOW.has_value()) {
+            // This hook executes on Unity's window thread, so window style and
+            // WndProc changes are safe here. Doing this from DXGI Present can
+            // deadlock the render thread while WM_STYLECHANGED is dispatched.
+            graphics_hook_window(result, nullptr);
+            log_info(
+                "udn",
+                "Unity window created and attached to Spice: hwnd={}, outer {}x{} at ({}, {})",
+                fmt::ptr(result), width, height, x, y);
+        }
+        return result;
+    }
+
+    static HWND WINAPI CreateWindowExA_hook(
+            DWORD ex_style, LPCSTR class_name, LPCSTR window_name, DWORD style,
+            int x, int y, int width, int height, HWND parent, HMENU menu,
+            HINSTANCE instance, LPVOID param) {
+
+        const bool is_unity = is_unity_window_class(class_name) &&
+            window_name && _stricmp(window_name, "DANCEaROUND") == 0;
+        if (is_unity && GRAPHICS_WINDOWED) {
+            style = force_udn_window_style(style);
+            get_udn_window_rect(style, ex_style, x, y, width, height);
+        }
+
+        const auto result = CreateWindowExA_orig(
+            ex_style, class_name, window_name, style,
+            x, y, width, height, parent, menu, instance, param);
+        if (result && is_unity && !GRAPHICS_HOOKED_WINDOW.has_value()) {
+            graphics_hook_window(result, nullptr);
+            log_info(
+                "udn",
+                "Unity window created and attached to Spice: hwnd={}, outer {}x{} at ({}, {})",
+                fmt::ptr(result), width, height, x, y);
+        }
+        return result;
+    }
+
+    static BOOL WINAPI SetWindowPos_hook(
+            HWND window, HWND insert_after,
+            int x, int y, int width, int height, UINT flags) {
+
+        if (GRAPHICS_WINDOWED && is_udn_unity_window(window)) {
+            const DWORD style = force_udn_window_style((DWORD) GetWindowLongPtrW(window, GWL_STYLE));
+            const DWORD ex_style = (DWORD) GetWindowLongPtrW(window, GWL_EXSTYLE);
+            if (get_udn_window_rect(style, ex_style, x, y, width, height)) {
+                flags &= ~(SWP_NOMOVE | SWP_NOSIZE);
+            }
+        }
+        return SetWindowPos_orig(window, insert_after, x, y, width, height, flags);
+    }
+
+    static BOOL WINAPI MoveWindow_hook(
+            HWND window, int x, int y, int width, int height, BOOL repaint) {
+
+        if (GRAPHICS_WINDOWED && is_udn_unity_window(window)) {
+            const DWORD style = force_udn_window_style((DWORD) GetWindowLongPtrW(window, GWL_STYLE));
+            const DWORD ex_style = (DWORD) GetWindowLongPtrW(window, GWL_EXSTYLE);
+            get_udn_window_rect(style, ex_style, x, y, width, height);
+        }
+        return MoveWindow_orig(window, x, y, width, height, repaint);
+    }
+
+    static LONG WINAPI SetWindowLongW_hook(HWND window, int index, LONG value) {
+        if (GRAPHICS_WINDOWED && index == GWL_STYLE && is_udn_unity_window(window)) {
+            value = (LONG) force_udn_window_style((DWORD) value);
+        }
+        return SetWindowLongW_orig(window, index, value);
+    }
+
+    static LONG WINAPI SetWindowLongA_hook(HWND window, int index, LONG value) {
+        if (GRAPHICS_WINDOWED && index == GWL_STYLE && is_udn_unity_window(window)) {
+            value = (LONG) force_udn_window_style((DWORD) value);
+        }
+        return SetWindowLongA_orig(window, index, value);
+    }
+
+    static LONG_PTR WINAPI SetWindowLongPtrA_hook(HWND window, int index, LONG_PTR value) {
+        if (GRAPHICS_WINDOWED && index == GWL_STYLE && is_udn_unity_window(window)) {
+            value = (LONG_PTR) force_udn_window_style((DWORD) value);
+        }
+        return SetWindowLongPtrA_orig(window, index, value);
+    }
+
+    static LONG_PTR WINAPI SetWindowLongPtrW_hook(HWND window, int index, LONG_PTR value) {
+        if (GRAPHICS_WINDOWED && index == GWL_STYLE && is_udn_unity_window(window)) {
+            value = (LONG_PTR) force_udn_window_style((DWORD) value);
+        }
+        return SetWindowLongPtrW_orig(window, index, value);
+    }
+
+    static BOOL WINAPI RegisterRawInputDevices_hook(
+            PCRAWINPUTDEVICE devices, UINT device_count, UINT structure_size) {
+
+        if (devices && device_count > 0 && devices[0].hwndTarget == RI_MGR->input_hwnd) {
+            return RegisterRawInputDevices_orig(devices, device_count, structure_size);
+        }
+
+        SetLastError(0xDEADBEEF);
+        return FALSE;
+    }
+
+    static BOOL WINAPI EnumDisplaySettingsW_hook(
+            LPCWSTR device_name, DWORD mode_number, DEVMODEW *mode) {
+
+        const auto result = EnumDisplaySettingsW_orig(device_name, mode_number, mode);
+        if (result && mode_number == ENUM_CURRENT_SETTINGS) {
+            mode->dmPelsWidth = 1920;
+            mode->dmPelsHeight = 1080;
+        }
+        return result;
+    }
+
+    static LONG WINAPI QueryDisplayConfig_hook(
+            UINT32, UINT32 *, DISPLAYCONFIG_PATH_INFO *, UINT32 *, DISPLAYCONFIG_MODE_INFO *,
+            DISPLAYCONFIG_TOPOLOGY_ID *) {
+        return ERROR_NOT_SUPPORTED;
+    }
+
+    void UDNGame::pre_attach() {
+        // The title has no MIDI controls. In the cabinet compatibility profile the
+        // legacy WinMM provider can fault in MMDevAPI while Unity and its audio
+        // backend initialize concurrently, so leave that unrelated subsystem
+        // unopened.
+        rawinput::DISABLE_MIDI = true;
+    }
+
+    void UDNGame::attach() {
+        Game::attach();
+
+        // The cabinet render surface is a 1920x3240-ish portrait stack. The host
+        // may reapply that size after startup, which puts
+        // most of the window outside a normal desktop. The game's built-in
+        // VirtualScreenEmurator renders to 1920x3252, so use its exact half
+        // scale and let the graphics hooks preserve the user's latest window
+        // rect when GameScreen later calls MoveWindow/SetWindowPos.
+        if (GRAPHICS_WINDOWED) {
+            if (!GRAPHICS_WINDOW_SIZE.has_value()) {
+                // The single-window compositor has a fixed 1920x3252 surface.
+                // 960x1626 is an exact 50% scale with no aspect-ratio crop.
+                GRAPHICS_WINDOW_SIZE = std::make_pair(960u, 1626u);
+            }
+            if (!GRAPHICS_WINDOW_POS.has_value()) {
+                const auto [width, height] = GRAPHICS_WINDOW_SIZE.value();
+                const auto x = std::max(0, (GetSystemMetrics(SM_CXSCREEN) - (int) width) / 2);
+                const auto y = std::max(0, (GetSystemMetrics(SM_CYSCREEN) - (int) height) / 2);
+                GRAPHICS_WINDOW_POS = std::format("{},{}", x, y);
+            }
+            if (!GRAPHICS_WINDOW_STYLE.has_value()) {
+                GRAPHICS_WINDOW_STYLE = cfg::WindowDecorationMode::ResizableFrame;
+            }
+            log_info(
+                "udn",
+                "managed Unity window: client {}x{}, position {}, resizable",
+                GRAPHICS_WINDOW_SIZE->first,
+                GRAPHICS_WINDOW_SIZE->second,
+                GRAPHICS_WINDOW_POS.value());
+        }
+
+        acio_handle = new acioemu::ACIOHandle(port_name.c_str(), 1);
+        devicehook_init_trampoline();
+        devicehook_add(acio_handle);
+
+        execexe::init();
+        execexe::init_deferred([]() {
+            execexe::init_port_hook(port_name, acio_handle);
+
+            // Runtime import names omit the "lib" prefix.
+            execexe::load_library("aio.dll");
+            execexe::load_library("aio-iob.dll");
+            execexe::load_library("aio-iob_video.dll");
+            execexe::load_library("aio-iob2_video.dll");
+            execexe::load_library("win10actlog.dll", false);
+
+#if SPICE64
+            if (!UDN_NO_IO) {
+                bi2x_hook_init();
+            }
+#endif
+        });
+
+        const auto user32_dll = "user32.dll";
+        detour::trampoline_try(user32_dll, "RegisterRawInputDevices",
+                               RegisterRawInputDevices_hook, &RegisterRawInputDevices_orig);
+        detour::trampoline_try(user32_dll, "QueryDisplayConfig",
+                               QueryDisplayConfig_hook, &QueryDisplayConfig_orig);
+        detour::trampoline_try(user32_dll, "EnumDisplaySettingsW",
+                               EnumDisplaySettingsW_hook, &EnumDisplaySettingsW_orig);
+        detour::trampoline_try(user32_dll, "CreateWindowExA",
+                               CreateWindowExA_hook, &CreateWindowExA_orig);
+        detour::trampoline_try(user32_dll, "CreateWindowExW",
+                               CreateWindowExW_hook, &CreateWindowExW_orig);
+        detour::trampoline_try(user32_dll, "SetWindowPos",
+                               SetWindowPos_hook, &SetWindowPos_orig);
+        detour::trampoline_try(user32_dll, "MoveWindow",
+                               MoveWindow_hook, &MoveWindow_orig);
+        detour::trampoline_try(user32_dll, "SetWindowLongA",
+                               SetWindowLongA_hook, &SetWindowLongA_orig);
+        detour::trampoline_try(user32_dll, "SetWindowLongW",
+                               SetWindowLongW_hook, &SetWindowLongW_orig);
+        detour::trampoline_try(user32_dll, "SetWindowLongPtrA",
+                               SetWindowLongPtrA_hook, &SetWindowLongPtrA_orig);
+        detour::trampoline_try(user32_dll, "SetWindowLongPtrW",
+                               SetWindowLongPtrW_hook, &SetWindowLongPtrW_orig);
+
+        if (GRAPHICS_SHOW_CURSOR) {
+            unity_utils::force_show_cursor(true);
+        }
+
+        unity_utils::set_args(
+                std::format("{} {}{}",
+                            GetCommandLineA(),
+                            UDN_INJECT_ARGS,
+                            unity_utils::get_unity_player_args()));
+    }
+
+    void UDNGame::detach() {
+        Game::detach();
+        devicehook_dispose();
+    }
+}
